{
  "manifest_version": 3,
  "name": "YTM Sound Effects",
  "version": "0.7.2",
  "description": "Studio-style EQ, reverb, bass, air, punch, warmth, stereo width and echo for YouTube Music, with presets, profiles, playback controls and ad silencing.",
  "permissions": ["storage"],
  "host_permissions": ["https://music.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["audio.js", "content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "YTM Sound Effects",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
